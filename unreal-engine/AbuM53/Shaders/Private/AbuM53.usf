#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

StructuredBuffer<float4> SourcePoints;
RWStructuredBuffer<float4> Projected;
RWStructuredBuffer<uint2> KeysOut;
uint PointCount;
uint OutputOffset;
uint TotalCount;
uint GroupCount;
uint DigitShift;
uint CropEnabled;
float4x4 LocalToClip;
float4x4 LocalToView;
float3 CameraLocal;
float3 CropMin;
float3 CropMax;
float2 ViewSize;
float Intensity;
float OpacityMultiplier;
float SplatScale;
float FilterVariance;

float3 RotateQ(float4 q, float3 v) { return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v); }
float SHScalar(uint p, uint k) { float4 v = SourcePoints[p*16 + 3 + k/4]; return v[k%4]; }
float3 Coefficient(uint p,uint k) { return float3(SHScalar(p,k*3),SHScalar(p,k*3+1),SHScalar(p,k*3+2)); }
float3 Appearance(uint p,uint degree,float3 d)
{
    float x=d.x,y=d.y,z=d.z;
    float3 c=0.5+0.28209479177387814*Coefficient(p,0);
    if(degree>0) c += 0.4886025119029199*(-y*Coefficient(p,1)+z*Coefficient(p,2)-x*Coefficient(p,3));
    if(degree>1) {
        c += 1.0925484305920792*(x*y*Coefficient(p,4)-y*z*Coefficient(p,5)-x*z*Coefficient(p,7));
        c += 0.31539156525252005*(3*z*z-1)*Coefficient(p,6)+0.5462742152960396*(x*x-y*y)*Coefficient(p,8);
    }
    if(degree>2) {
        c += -0.5900435899266435*y*(3*x*x-y*y)*Coefficient(p,9);
        c += 2.890611442640554*x*y*z*Coefficient(p,10);
        c += -0.4570457994644658*y*(5*z*z-1)*Coefficient(p,11);
        c += 0.3731763325901154*z*(5*z*z-3)*Coefficient(p,12);
        c += -0.4570457994644658*x*(5*z*z-1)*Coefficient(p,13);
        c += 1.445305721320277*z*(x*x-y*y)*Coefficient(p,14);
        c += -0.5900435899266435*x*(x*x-3*y*y)*Coefficient(p,15);
    }
    return max(c,0);
}
float3 DecodeSRGB(float3 c) { c=clamp(c,0,64);return lerp(c/12.92,pow((c+0.055)/1.055,2.4),step(0.04045,c)); }
float2 ProjectAxis(float4 center,float3 axis)
{
    float4 d=mul(float4(axis,0),LocalToClip);
    // The affine approximation is unstable for means far outside the frustum.
    // Bound only its perspective slope; retain the real mean and source shape.
    // For orthographic projection d.w is zero, so this leaves the Jacobian exact.
    float2 derivativeNDC=clamp(center.xy/center.w,-1.3,1.3);
    return (d.xy-derivativeNDC*d.w)/center.w*ViewSize*float2(0.5,-0.5);
}
#if COMPUTESHADER
[numthreads(256,1,1)]
void ProjectCS(uint lane:SV_GroupIndex,uint3 group:SV_GroupID)
{
    uint p=(group.x+group.y*65535u)*256u+lane;if(p>=PointCount)return;uint o=OutputOffset+p;
    Projected[o*3]=0;Projected[o*3+1]=0;Projected[o*3+2]=0;KeysOut[o]=uint2(0,o);
    float4 pos=SourcePoints[p*16];
    if(CropEnabled!=0 && (any(pos.xyz<CropMin)||any(pos.xyz>CropMax)))return;
    float4 clip=mul(float4(pos.xyz,1),LocalToClip);
    float viewDepth=mul(float4(pos.xyz,1),LocalToView).z;
    // Our screen-space quads bypass hardware clipping. Enforce UE's [0,w]
    // clip-depth interval here, including the reversed-Z near plane at z=w.
    if(!all(isfinite(clip)) || !isfinite(viewDepth) || clip.w<=0.00001 || viewDepth<=0.00001 || clip.z<0 || clip.z>clip.w)return;
    float3 s=SourcePoints[p*16+1].xyz*SplatScale;
    float4 q=normalize(SourcePoints[p*16+2]);
    float2 a=ProjectAxis(clip,RotateQ(q,float3(s.x,0,0)));
    float2 b=ProjectAxis(clip,RotateQ(q,float3(0,s.y,0)));
    float2 c=ProjectAxis(clip,RotateQ(q,float3(0,0,s.z)));
    float xx=dot(float3(a.x,b.x,c.x),float3(a.x,b.x,c.x))+FilterVariance;
    float xy=a.x*a.y+b.x*b.y+c.x*c.y;
    float yy=dot(float3(a.y,b.y,c.y),float3(a.y,b.y,c.y))+FilterVariance;
    float determinant=xx*yy-xy*xy;
    if(determinant<=1e-12 || !isfinite(determinant))return;
    float2 radius=3*sqrt(float2(xx,yy));
    float2 mean=(clip.xy/clip.w*float2(0.5,-0.5)+0.5)*ViewSize;
    if(!all(isfinite(mean))||!all(isfinite(radius)))return;
    if(any(mean+radius<0)||any(mean-radius>ViewSize))return;
    float alpha=min(0.999,pos.w*OpacityMultiplier);
    if(SourcePoints[p*16+15].z>0.5){float rawDet=(xx-FilterVariance)*(yy-FilterVariance)-xy*xy;alpha*=sqrt(max(rawDet,0)/determinant);}
    float3 dir=normalize(pos.xyz-CameraLocal);
    float3 color=DecodeSRGB(Appearance(p,(uint)SourcePoints[p*16+1].w,dir))*Intensity*View.PreExposure;
    Projected[o*3]=float4(mean,radius);
    Projected[o*3+1]=float4(yy/determinant,-xy/determinant,xx/determinant,alpha);
    Projected[o*3+2]=float4(color,clip.z/clip.w);
    KeysOut[o]=uint2(asuint(viewDepth),o);
}

StructuredBuffer<uint2> KeysIn;
RWStructuredBuffer<uint> Histogram;
StructuredBuffer<uint> HistogramIn;
RWStructuredBuffer<uint> Offsets;
StructuredBuffer<uint> OffsetsIn;
groupshared uint BinCounts[16];
groupshared uint LocalDigits[256];
groupshared uint LocalRanks[256];
[numthreads(256,1,1)]
void HistogramCS(uint3 id:SV_DispatchThreadID,uint lane:SV_GroupIndex,uint3 group:SV_GroupID)
{
    uint g=group.x+group.y*65535u;
    if(g>=GroupCount)return;
    uint index=g*256u+lane;
    if(lane<16)BinCounts[lane]=0;GroupMemoryBarrierWithGroupSync();
    if(index<TotalCount){uint ignored;InterlockedAdd(BinCounts[(KeysIn[index].x>>DigitShift)&15],1,ignored);}
    GroupMemoryBarrierWithGroupSync();if(lane<16)Histogram[lane*GroupCount+g]=BinCounts[lane];
}
[numthreads(16,1,1)]
void PrefixCS(uint lane:SV_GroupIndex)
{
    uint own=0;for(uint g=0;g<GroupCount;g++)own+=HistogramIn[lane*GroupCount+g];
    BinCounts[lane]=own;GroupMemoryBarrierWithGroupSync();
    uint total=0;for(uint b=0;b<lane;b++)total+=BinCounts[b];
    for(uint outputGroup=0;outputGroup<GroupCount;outputGroup++){uint n=HistogramIn[lane*GroupCount+outputGroup];Offsets[lane*GroupCount+outputGroup]=total;total+=n;}
}
[numthreads(256,1,1)]
void ScatterCS(uint3 id:SV_DispatchThreadID,uint lane:SV_GroupIndex,uint3 group:SV_GroupID)
{
    uint g=group.x+group.y*65535u;
    if(g>=GroupCount)return;
    uint index=g*256u+lane;
    uint2 key=index<TotalCount?KeysIn[index]:uint2(0,0);
    uint digit=(key.x>>DigitShift)&15;LocalDigits[lane]=index<TotalCount?digit:16;
    LocalRanks[lane]=0;
    GroupMemoryBarrierWithGroupSync();
    if(lane<16){uint rank=0;for(uint n=0;n<256;n++)if(LocalDigits[n]==lane)LocalRanks[n]=rank++;}
    GroupMemoryBarrierWithGroupSync();
    if(index<TotalCount)KeysOut[OffsetsIn[digit*GroupCount+g]+LocalRanks[lane]]=key;
}
#endif
StructuredBuffer<float4> ProjectedIn;
StructuredBuffer<uint2> SortedKeys;
StructuredBuffer<uint> TileOverflow;
struct DrawVaryings {float4 Position:SV_Position;float2 Delta:TEXCOORD0;nointerpolation float4 Conic:TEXCOORD1;nointerpolation float4 ColorDepth:TEXCOORD2;};
DrawVaryings DrawVS(uint vertex:SV_VertexID,uint instance:SV_InstanceID)
{
    if(TileOverflow[0]==0){DrawVaryings empty=(DrawVaryings)0;empty.Position.w=1;return empty;}
    const float2 corners[6]={float2(-1,-1),float2(1,-1),float2(-1,1),float2(-1,1),float2(1,-1),float2(1,1)};
    uint p=SortedKeys[TotalCount-1-instance].y;float4 mean=ProjectedIn[p*3];
    DrawVaryings o;o.Delta=corners[vertex]*mean.zw;
    float2 pixel=mean.xy+o.Delta;o.Position=float4((pixel/ViewSize-0.5)*float2(2,-2),0,1);
    o.Conic=ProjectedIn[p*3+1];o.ColorDepth=ProjectedIn[p*3+2];return o;
}
Texture2D SceneDepth;
float AlphaCutoff;
float4 DrawPS(DrawVaryings i):SV_Target0
{
    if(i.Conic.w<=0)discard;
    float depth=SceneDepth.Load(int3((int2)i.Position.xy,0)).r;
    if(depth>i.ColorDepth.w+1e-6)discard;
    float power=-0.5*(i.Conic.x*i.Delta.x*i.Delta.x+2*i.Conic.y*i.Delta.x*i.Delta.y+i.Conic.z*i.Delta.y*i.Delta.y);
    if(power < -4.5)discard;float alpha=i.Conic.w*exp(power);if(alpha<AlphaCutoff)discard;
    return float4(i.ColorDepth.rgb*alpha,alpha);
}
struct FullVaryings{float4 Position:SV_Position;};
FullVaryings SoftwareVS(uint vertex:SV_VertexID)
{
    FullVaryings o;float2 p=float2((vertex<<1)&2,vertex&2);o.Position=float4(p*float2(2,-2)+float2(-1,1),0,1);return o;
}
StructuredBuffer<float4> SoftwarePixels;
float2 ViewMin;
float2 SoftwareSize;
float4 SoftwarePS(FullVaryings i):SV_Target0
{
    uint2 pixel=min((uint2)((i.Position.xy-ViewMin)/ViewSize*SoftwareSize),(uint2)SoftwareSize-1);
    float4 c=SoftwarePixels[pixel.y*(uint)SoftwareSize.x+pixel.x];
    return float4(c.rgb*View.PreExposure,c.a);
}
